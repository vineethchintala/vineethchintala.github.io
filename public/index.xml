<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Vineeth Chintala</title><link>https://vineethchintala.com/</link><description>Recent content on Vineeth Chintala</description><generator>Hugo</generator><language>en-us</language><atom:link href="https://vineethchintala.com/index.xml" rel="self" type="application/rss+xml"/><item><title>Book</title><link>https://vineethchintala.com/book/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://vineethchintala.com/book/</guid><description>&lt;h2 id="intro-to-graph-theory"&gt;Intro to Graph Theory&lt;/h2&gt;
&lt;p&gt;I taught intro courses on graph theory at IISc (in 2024 and 2025). During this time, I was also working on my book - Graphs, Games, Algorithms.&lt;/p&gt;
&lt;p&gt;&lt;div class="book-box"&gt;
 &lt;img src='https://vineethchintala.com/graphs.jpg' alt='Graphs, Games, Algorithms Book Cover'&gt;
 &lt;div class="book-content"&gt;
 &lt;h3&gt;Graphs, Games, Algorithms&lt;/h3&gt;
 &lt;a href="https://drive.google.com/file/d/16zmmdpEycsWnPuE6XYqkX31RJ_lMnC5S/view"&gt;Free eBook&lt;/a&gt;  •  &lt;a href="https://www.amazon.com/dp/B0G7Y588JN"&gt;Amazon (US)&lt;/a&gt;
 &lt;/div&gt;
&lt;/div&gt;
The book has four parts:&lt;/p&gt;
&lt;blockquote&gt;
&lt;p&gt;&lt;strong&gt;Better Way:&lt;/strong&gt; uses puzzles to introduce core principles &lt;br&gt;
&lt;strong&gt;Way Better:&lt;/strong&gt; covers classic algorithms &lt;br&gt;
&lt;strong&gt;The Unreasonable Power of Linear Algebra:&lt;/strong&gt; showcases algebraic techniques &lt;br&gt;
&lt;strong&gt;Senses of a Graph:&lt;/strong&gt; surveys major themes&lt;/p&gt;</description></item><item><title>Cinema</title><link>https://vineethchintala.com/movies/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://vineethchintala.com/movies/</guid><description>&lt;h2 id="perfect-endings-in-cinema"&gt;Perfect Endings in Cinema&lt;/h2&gt;
&lt;blockquote&gt;
&lt;p&gt;Once in a while a movie elevates itself with a perfect finish, with a final unforgettable impression. It can be the difference between going home satisfied and still remembering it years later. The difference between passing joy and lifelong love.&lt;/p&gt;
&lt;/blockquote&gt;
&lt;p&gt;&lt;strong&gt;Rules:&lt;/strong&gt; In no particular order. With few words and No spoilers!&lt;/p&gt;
&lt;div class="cinema-list-container"&gt;
 
&lt;/div&gt;

&lt;script&gt;
document.addEventListener("DOMContentLoaded", function() {
 const listContainer = document.querySelector('.cinema-list-container');
 const container = listContainer.parentNode;
 
 
 let siblingBefore = listContainer.previousElementSibling;
 
 while (siblingBefore &amp;&amp; siblingBefore.tagName !== 'P' &amp;&amp; siblingBefore.tagName !== 'H2' &amp;&amp; siblingBefore.tagName !== 'BLOCKQUOTE') {
 siblingBefore = siblingBefore.previousElementSibling;
 }
 
 if (siblingBefore &amp;&amp; siblingBefore.tagName === 'P' &amp;&amp; siblingBefore.querySelector('strong') &amp;&amp; siblingBefore.querySelector('strong').textContent.includes('Rules')) {
 siblingBefore.style.fontSize = '0.82rem';
 siblingBefore.style.opacity = '0.7';
 siblingBefore.style.fontFamily = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif";
 siblingBefore.style.letterSpacing = '0.02em';
 siblingBefore.style.marginTop = '1.5rem';
 siblingBefore.style.marginBottom = '2rem';
 }

 const h4s = Array.from(container.querySelectorAll('h4'));

 h4s.forEach(h4 =&gt; {
 const text = h4.textContent.trim();
 
 
 const numMatch = text.match(/^(\d+)/);
 const num = numMatch ? numMatch[1] : '';

 
 const yearMatch = text.match(/\(?(\d{4})\)?$/);
 const year = yearMatch ? yearMatch[1] : '';

 
 let title = text;
 if (num) title = title.replace(/^\d+\.\s*/, '');
 if (year) title = title.replace(/\s*\(?\d{4}\)?$/, '').replace(/,\s*$/, '');

 
 const row = document.createElement('div');
 row.className = 'film-row';

 
 const titleBlock = document.createElement('div');
 titleBlock.className = 'film-title-block';
 
 const numSpan = document.createElement('span');
 numSpan.className = 'film-num';
 numSpan.textContent = num;
 titleBlock.appendChild(numSpan);

 const titleText = document.createTextNode(title);
 titleBlock.appendChild(titleText);

 if (year) {
 const yearSpan = document.createElement('span');
 yearSpan.className = 'film-year';
 yearSpan.textContent = ` (${year})`;
 titleBlock.appendChild(yearSpan);
 }
 
 row.appendChild(titleBlock);

 
 const commentaryBlock = document.createElement('div');
 commentaryBlock.className = 'film-commentary';

 
 let sibling = h4.nextElementSibling;
 const toMove = [];
 while (sibling &amp;&amp; sibling.tagName !== 'H4' &amp;&amp; sibling.tagName !== 'SCRIPT' &amp;&amp; sibling !== listContainer) {
 toMove.push(sibling);
 sibling = sibling.nextElementSibling;
 }

 
 toMove.forEach(el =&gt; {
 commentaryBlock.appendChild(el);
 });
 row.appendChild(commentaryBlock);

 
 listContainer.appendChild(row);

 
 h4.parentNode.removeChild(h4);
 });
});
&lt;/script&gt;

&lt;h4 id="01-chungking-express-1994"&gt;01. Chungking Express (1994)&lt;/h4&gt;
&lt;p&gt;Shows how effective, and playful, symmetry can be in storytelling. After all, nothing makes a relationship look more convincing than me becoming like you and you becoming like me.&lt;/p&gt;</description></item><item><title>Library</title><link>https://vineethchintala.com/favourite-reads/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://vineethchintala.com/favourite-reads/</guid><description>&lt;h2 id="great-reading-experiences"&gt;Great Reading Experiences&lt;/h2&gt;
&lt;blockquote&gt;
&lt;p&gt;Craving for a new book is like craving for a new friend - who we expect to have all the qualities of the old ones and still be able to constantly surprise us.&lt;/p&gt;
&lt;/blockquote&gt;
&lt;div class="reads-page-grid"&gt;
 &lt;div class="reads-sidebar"&gt;
 &lt;div class="reads-menu"&gt;
 
 &lt;/div&gt;
 &lt;/div&gt;
 &lt;div class="reads-content-column"&gt;
 
 &lt;/div&gt;
&lt;/div&gt;

&lt;script&gt;
document.addEventListener("DOMContentLoaded", function() {
 const pageGrid = document.querySelector('.reads-page-grid');
 const menuContainer = pageGrid.querySelector('.reads-menu');
 const contentColumn = pageGrid.querySelector('.reads-content-column');

 
 const container = pageGrid.parentNode;
 const h3s = Array.from(container.querySelectorAll('h3'));
 
 const sections = [];

 h3s.forEach((h3, index) =&gt; {
 const text = h3.textContent.trim();
 const id = text.toLowerCase().replace(/[^a-z0-9]/g, '-');

 
 const section = document.createElement('div');
 section.className = 'reads-section';
 section.id = id + '-section';
 
 const readingContent = document.createElement('div');
 readingContent.className = 'reading-content';
 section.appendChild(readingContent);
 
 if (index === 0) {
 section.classList.add('active');
 }

 
 let sibling = h3.nextElementSibling;
 const toMove = [];
 while (sibling &amp;&amp; sibling.tagName !== 'H3' &amp;&amp; sibling.tagName !== 'SCRIPT' &amp;&amp; sibling !== pageGrid) {
 toMove.push(sibling);
 sibling = sibling.nextElementSibling;
 }

 
 toMove.forEach(el =&gt; readingContent.appendChild(el));
 
 
 contentColumn.appendChild(section);
 sections.push(section);

 
 const button = document.createElement('button');
 button.className = 'reads-menu-item';
 if (index === 0) {
 button.classList.add('active');
 }
 button.textContent = text.toUpperCase();
 button.setAttribute('data-target', id);
 
 button.addEventListener('click', function() {
 
 menuContainer.querySelectorAll('.reads-menu-item').forEach(btn =&gt; btn.classList.remove('active'));
 sections.forEach(sec =&gt; sec.classList.remove('active'));

 
 this.classList.add('active');
 section.classList.add('active');
 });

 menuContainer.appendChild(button);

 
 h3.parentNode.removeChild(h3);
 });
});
&lt;/script&gt;

